digraph LogicalSchema {
  graph [rankdir=LR, splines=spline, overlap=false, nodesep=0.4, ranksep=1.1, fontname="Helvetica", labelloc="t", fontsize=22, label="Project Part II - Logical Schema (PostgreSQL 16)\nPart I insurance entities + hybrid data extension"];
  node [shape=plaintext, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9, color="#555555", arrowhead=crow, arrowtail=none, dir=both, arrowsize=0.9];
