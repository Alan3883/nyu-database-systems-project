    subgraph GOV["GOVERNANCE — spans all four domains"]
        direction LR
        G1["<b>Data quality</b><br/>SHA-256 checksums<br/>key uniqueness<br/>foreign keys<br/>FIPS validation"]
        G2["<b>Lifecycle and lineage</b><br/>immutable raw versions<br/>DATASET → DATA_ASSET<br/>→ chunk → run<br/>retention"]
        G3["<b>Access and integrity</b><br/>least privilege<br/>atomic transactions<br/>no credentials in VCS<br/>no patient-level data"]
        G4["<b>Model governance</b><br/>model versioning<br/>mandatory human review<br/>reviewer identity<br/>rollback by inaction"]
        G5["<b>Fairness, accountability,<br/>transparency</b><br/>no pricing or eligibility use<br/>audit trail<br/>labelled research context"]
        G1 --- G2 --- G3 --- G4 --- G5
    end

    BUS ==> APP
    APP ==> DIKW
    DIKW ==> INF
    INF ==> GOV

